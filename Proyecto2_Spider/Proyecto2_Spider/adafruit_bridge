#import standard python modules
import sys
import time
import serial

#Adafruit IO MQTT client
from Adafruit_IO import MQTTClient

#importamos desde nuestro archivo privado con la clave y usuario
from config import ADAFRUIT_IO_USERNAME, ADAFRUIT_IO_KEY, SERIAL_PORT, BAUDRATE

# Feeds principales
FEED_ID_RECIEVE = "Spider_TX"
FEED_ID_SEND = "Spider_RX"

SERVO_FEEDS = {
    "Spider-S0": 0,
    "Spider-S1": 1,
    "Spider-S2": 2,
    "Spider-S3": 3,
    "Spider-S4": 4,
    "Spider-S5": 5,
}

def enviar_arduino(comando):
    comando = str(comando).strip()

    if comando == "":
        return
    
    print ("Enviando al Arduino:", comando)

    #El arduino espera texto + Enter
    myArduino.write((comando + "\n").encode("utf-8"))

def connected(client):
    print("Conectado a Adafruit IO")
    print("Suscribiendo al feed>",  FEED_ID_RECIEVE)

    client.subscribe(FEED_ID_RECIEVE)

    for feed in SERVO_FEEDS:
        client.subscribe(feed)
        print("Suscrito a:", feed)

    print("Esprerando datos...")

def disconnected(client):
    print("Desconectado de Adafruit IO")
    sys.exit(1)

def message(client, feed_id, payload):
    print("Feed {0} received new value: {1}".format(feed_id, payload))

    if feed_id == FEED_ID_RECIEVE:
        enviar_arduino(payload)
        client.publish(FEED_ID_SEND, "Sent:" + str(payload)) 
    elif feed_id in SERVO_FEEDS:
        servo = SERVO_FEEDS[feed_id]

        try:
            valor = int(float(payload))
        except ValueError:
            print("Valor invalido:", payload)
            return
        
        if (valor < 0):
            valor = 0
        if (valor > 255):
            valor = 255

        comando = "S{}:{}".format(servo, valor)
        enviar_arduino(comando)

try:
    #crear cliente MQTT
    client = MQTTClient(ADAFRUIT_IO_USERNAME, ADAFRUIT_IO_KEY)

    #conexion seria con Arduino Nano
    myArduino = serial.Serial(port=SERIAL_PORT, baudrate=BAUDRATE, timeout=0.1)
    time.sleep(2)

    #configurar callbacks
    client.on_connect = connected
    client.on_disconnect = disconnected
    client.on_message = message

    #conectar con Adafruit IO
    client.connect()

    client.loop_background()

    while True:
        #leer respuestas del arduino
        if myArduino.in_waiting > 0:
            respuesta = myArduino.readline().decode("utf-8", errors="ignore").strip()

            if respuesta:
                print("Arduino:", respuesta)
                client.publish(FEED_ID_SEND, respuesta)

        time.sleep(0.1)

except KeyboardInterrupt:
    print("Adios")

    if "myArduino" in globals() and myArduino.is_open:
        myArduino.close()

    sys.exit(1)
