# Import standard python modules.
import sys
import time
import serial

# This example uses the MQTTClient instead of the REST client
from Adafruit_IO import MQTTClient

# Set to your Adafruit IO username and key.
ADAFRUIT_IO_USERNAME = "usuario"
ADAFRUIT_IO_KEY = "key"

# Serial connection to Arduino Nano
myArduino = serial.Serial(port="COM5", baudrate=9600, timeout=0.1)
time.sleep(2)

# Feeds
FEED_ID_receive = "Spider_TX"
FEED_ID_Send = "Spider_RX"


def connected(client):
    print("Subscribing to Feed {0}".format(FEED_ID_receive))
    client.subscribe(FEED_ID_receive)
    print("Waiting for feed data...")


def disconnected(client):
    sys.exit(1)


def message(client, feed_id, payload):
    print("Feed {0} received new value: {1}".format(feed_id, payload))

    # Send payload to Arduino through UART
    comando = str(payload).strip()
    print("Sending to Arduino: {0}".format(comando))

    myArduino.write((comando + "\n").encode("utf-8"))

    # Optional: publish feedback to Adafruit
    client.publish(FEED_ID_Send, "Sent: " + comando)


# Create an MQTT client instance.
client = MQTTClient(ADAFRUIT_IO_USERNAME, ADAFRUIT_IO_KEY)

# Setup the callback functions defined above.
client.on_connect = connected
client.on_disconnect = disconnected
client.on_message = message

# Connect to the Adafruit IO server.
client.connect()

# Run MQTT in background
client.loop_background()

while True:
    if myArduino.in_waiting > 0:
        respuesta = myArduino.readline().decode("utf-8", errors="ignore").strip()

        if respuesta:
            print("Arduino:", respuesta)
            client.publish(FEED_ID_Send, respuesta)

    time.sleep(0.1)